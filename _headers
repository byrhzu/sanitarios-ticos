# ============================================================================
# Cabeceras para Cloudflare Pages.
# Cloudflare NO lee .htaccess (eso es de servidores Apache), así que las reglas
# de caché y seguridad van aquí. Este archivo se sube junto a las páginas.
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # frame-ancestors deja que el sitio público se muestre dentro de baizzen.com
  # (el mini-navegador de la página de casos) y en ningún otro sitio. Por eso
  # ya no va X-Frame-Options: no sabe permitir un dominio en particular. El
  # panel, los documentos y las cotizaciones siguen cerrados más abajo.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://baizzen.com https://www.baizzen.com

# El panel y las cotizaciones llevan datos personales: que ningún buscador
# los indexe, ni siquiera si alguien filtra un enlace. (El header manda
# aunque no haya <meta>, y cubre las respuestas que no son HTML.)
/panel*
  X-Robots-Tag: noindex, nofollow
  # La marca que el service worker usa para saber que lo que llegó es el
  # panel de verdad y no la pantalla de ingreso de Cloudflare Access.
  X-Panel: 1
  # El panel no se mete en un marco de nadie, ni siquiera del propio
  # sitio: dentro de un iframe se puede engañar a quien lo usa para que
  # toque cosas que no ve.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  # Que no quede guardado en ningún intermediario: lleva datos de clientes.
  Cache-Control: no-store
/documento*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors 'self'
  # El certificado y el tiquete llevan el nombre y la cédula del
  # cliente: no deben quedar en cachés compartidas de nadie.
  Cache-Control: private, no-store

/cotizacion*
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: frame-ancestors 'self'
  # El documento lo abre el cliente por un enlace con llave; no debe
  # quedar en cachés compartidas de operadores ni de proxies.
  Cache-Control: private, no-store

# Las páginas siempre se revalidan: al publicar un cambio se ve de inmediato.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# El código lleva ?v= en el enlace, pero igual se revalida por seguridad.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/main.js
  Cache-Control: public, max-age=0, must-revalidate

/lib/*
  Cache-Control: public, max-age=0, must-revalidate

# Las imágenes y el favicon cambian de nombre cuando cambian: caché larga.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/favicon.svg
  Cache-Control: public, max-age=2592000

# ---------------------------------------------------------------------------
# La aplicación instalable del panel.
# Estos dos SIEMPRE se revalidan. Si el navegador se queda con un sw.js viejo
# guardado, el teléfono sigue sirviendo la copia anterior del panel aunque ya
# se haya publicado una nueva, y no hay forma de sacarlo de ahí.
# ---------------------------------------------------------------------------
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json; charset=utf-8
